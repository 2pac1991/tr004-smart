#!/bin/bash
# tr004-smart - SMART-Werte von Platten im QNAP TR-004 (JMicron JMB39x) sicher auslesen.
#
# Der TR-004 reicht SMART-Befehle nicht per USB durch. Die einzige Methode (auch die der
# QNAP-Software) ist ein "Briefkasten"-Sektor: Ein Befehlspaket wird in einen Sektor einer
# Platte im Gehaeuse geschrieben, der JMicron-Chip antwortet ueber denselben Sektor.
# smartctl kann das (-d jmb39x-q). Geht dabei etwas schief, bleibt das Paket auf der Platte
# liegen - in Sektor 33 (Standard) zerstoert das die GPT-Partitionstabelle.
#
# Dieses Skript macht das sicher:
#   * nie Sektor 33, sondern ein nachweislich freier Sektor in der Luecke vor der 1. Partition
#   * Abbild der Sektoren 0..63 ALLER TR-004-Platten vorher, Vergleich nachher,
#     jede Abweichung wird sofort zurueckgeschrieben und geprueft
#   * nur ein Lauf gleichzeitig (Sperre), Abbruch bei unerwarteter Plattenaufteilung
#
# Lizenz: MIT - Nutzung auf eigenes Risiko, siehe README.md

set -u
VERSION="0.2.0"

# ---------- Einstellungen (per Umgebung oder /boot/config/tr004-smart.conf ueberschreibbar) ----------
PLUGCFG=/boot/config/plugins/tr004-smart
CONF="${TR004_CONF:-$PLUGCFG/tr004-smart.cfg}"
[ -r "$CONF" ] && . "$CONF"
STATE_DIR="${TR004_STATE_DIR:-/var/lib/tr004-smart}"     # Sicherungen + Ergebnisse
SNAP_SECTORS="${TR004_SNAP_SECTORS:-64}"                  # so viele Sektoren am Plattenanfang werden gesichert
MAILBOX_LBA="${TR004_MAILBOX_LBA:-48}"                    # Briefkasten-Sektor (nie 33!)
PORTS="${TR004_PORTS:-0 1 2 3}"                            # Einschuebe des TR-004
SMARTCTL="${TR004_SMARTCTL:-$( [ -x /usr/sbin/smartctl.real ] && echo /usr/sbin/smartctl.real || echo smartctl)}"
DEVTYPE="${TR004_DEVTYPE:-jmb39x-q}"                       # QNAP-Variante des JMicron-Protokolls
ENABLED_FLAG="${TR004_ENABLED_FLAG:-$PLUGCFG/enabled}"
DEV_GLOB="${TR004_DEV_GLOB:-/dev/disk/by-id/usb-QNAP_TR-004_DISK*}"
LOCK="${TR004_LOCK:-/var/lock/tr004-smart.lock}"

# ---------- Hilfsfunktionen ----------
# Sprache: wie die Unraid-Oberflaeche (Einstellungen > Anzeige), sonst Systemsprache, sonst Englisch
if [ -z "${TR004_LANG:-}" ]; then
  _loc=$(sed -n 's/^locale="\(.*\)"/\1/p' /boot/config/plugins/dynamix/dynamix.cfg 2>/dev/null)
  case "${_loc:-${LANG:-en}}" in de*) TR004_LANG=de ;; *) TR004_LANG=en ;; esac
fi
t() { if [ "$TR004_LANG" = de ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }   # t "deutsch" "english"
die()  { local m; m="$(t FEHLER ERROR): $*"; echo "$m" >&2; logger -t tr004-smart "$m" 2>/dev/null; exit 2; }
warn() { local m; m="$(t WARNUNG WARNING): $*"; echo "$m" >&2; logger -t tr004-smart "$m" 2>/dev/null; }
info() { [ "${QUIET:-0}" = 1 ] || echo "$*" >&2; }

# Sektoren lesen/schreiben - auf Blockgeraeten am Cache vorbei (O_DIRECT)
rd() {  # rd <dev> <lba> <anzahl>
  local f=""; [ -b "$1" ] && f="iflag=direct"
  dd if="$1" bs=512 skip="$2" count="$3" $f 2>/dev/null
}
wr() {  # wr <dev> <lba> <datei>   (Datei = ganze Sektoren)
  local f="conv=notrunc"; [ -b "$1" ] && f="oflag=direct,sync conv=notrunc"
  dd if="$3" of="$1" bs=512 seek="$2" $f 2>/dev/null && sync
}
is_zero() { [ -z "$(tr -d '\000' < "$1" | head -c1)" ]; }
u32le()  { od -An -tu4 -j"$2" -N4 "$1" | tr -d ' '; }
u64le()  { od -An -tu8 -j"$2" -N8 "$1" | tr -d ' '; }

tr004_devices() {
  local d; for d in $DEV_GLOB; do
    case "$d" in *-part[0-9]*) continue ;; esac
    [ -e "$d" ] && readlink -f "$d"
  done | sort -u
}

# Kennung (erste 16 Bytes) des ersten Partitionssektors jeder Platte - nur zur Kontrolle,
# wird NIE zurueckgeschrieben (das Dateisystem darf diesen Sektor selbst aendern).
part_magic() {
  local d typ first last
  for d in $(tr004_devices); do
    read -r typ first last < <(layout "$d")
    [ "$first" -gt 0 ] 2>/dev/null || continue
    echo "$d $first $(rd "$d" "$first" 1 | head -c 4 | od -An -tx1 | tr -d ' \n')"
  done
}

# Erste belegte Partition und Ende der Partitionstabelle bestimmen.
# Ausgabe: "<typ> <erster_partitionsstart> <letzter_tabellensektor>"
layout() {
  local dev="$1" t; t=$(mktemp); rd "$dev" 0 34 > "$t"
  local sig; sig=$(od -An -tx1 -j510 -N2 "$t" | tr -d ' ')
  if [ "$(dd if="$t" bs=1 skip=512 count=8 2>/dev/null | tr -d "\000")" = "EFI PART" ]; then
    local ent_lba n_ent ent_sz first=""
    ent_lba=$(u64le "$t" $((512+72))); n_ent=$(u32le "$t" $((512+80))); ent_sz=$(u32le "$t" $((512+84)))
    local last_tab=$(( ent_lba + (n_ent*ent_sz + 511)/512 - 1 ))
    local tabf; tabf=$(mktemp); rd "$dev" "$ent_lba" $(( (n_ent*ent_sz+511)/512 )) > "$tabf"
    local i s
    for ((i=0;i<n_ent;i++)); do
      s=$(u64le "$tabf" $((i*ent_sz+32)))
      [ "$s" != "0" ] && { [ -z "$first" ] || [ "$s" -lt "$first" ]; } && first=$s
    done
    rm -f "$tabf" "$t"; echo "gpt ${first:-0} $last_tab"; return
  fi
  if [ "$sig" = "55aa" ]; then
    local i s first=""
    for i in 0 1 2 3; do
      s=$(u32le "$t" $((446+i*16+8)))
      [ "$s" != "0" ] && { [ -z "$first" ] || [ "$s" -lt "$first" ]; } && first=$s
    done
    rm -f "$t"; echo "mbr ${first:-0} 0"; return
  fi
  rm -f "$t"; echo "none 0 0"
}

# Ist MAILBOX_LBA auf diesem Geraet nachweislich ungenutzt?
mailbox_ok() {
  local dev="$1" typ first last; read -r typ first last < <(layout "$dev")
  [ "$MAILBOX_LBA" -eq 33 ] && { t "Sektor 33 ist gesperrt (gehoert zur GPT)" "sector 33 is not allowed (belongs to the GPT)"; echo; return 1; }
  [ "$MAILBOX_LBA" -ge "$SNAP_SECTORS" ] && { t "Briefkasten muss < $SNAP_SECTORS sein" "mailbox sector must be < $SNAP_SECTORS"; echo; return 1; }
  case "$typ" in
    gpt) [ "$MAILBOX_LBA" -le "$last" ] && { t "Sektor $MAILBOX_LBA liegt in der GPT-Tabelle (bis $last)" "sector $MAILBOX_LBA lies inside the GPT table (up to $last)"; echo; return 1; } ;;
    mbr) ;;
    *)   t "keine erkennbare Partitionstabelle - zu unsicher" "no recognizable partition table - not safe"; echo; return 1 ;;
  esac
  [ "$first" -le "$MAILBOX_LBA" ] && { t "1. Partition beginnt bei $first, Sektor $MAILBOX_LBA waere darin" "first partition starts at $first, sector $MAILBOX_LBA would be inside it"; echo; return 1; }
  [ "$first" -lt "$SNAP_SECTORS" ] && { t "1. Partition beginnt vor Sektor $SNAP_SECTORS ($first)" "first partition starts before sector $SNAP_SECTORS ($first)"; echo; return 1; }
  local s; s=$(mktemp); rd "$dev" "$MAILBOX_LBA" 1 > "$s"
  if ! is_zero "$s"; then
    if [ -n "$(tr -d '\000' < "$s" | head -c 64)" ] && od -An -tx1 -N4 "$s" | tr -s " " | grep -q "25 03 7b 19"; then
      t "Sektor $MAILBOX_LBA enthaelt ein altes JMicron-Paket (Rest eines frueheren Abbruchs)" "sector $MAILBOX_LBA contains an old JMicron packet (left over from an earlier abort)"; echo
    else
      t "Sektor $MAILBOX_LBA ist nicht leer" "sector $MAILBOX_LBA is not empty"; echo
    fi
    rm -f "$s"; return 1
  fi
  rm -f "$s"; t "$typ, 1. Partition ab $first, Sektor $MAILBOX_LBA frei" "$typ, first partition at $first, sector $MAILBOX_LBA free"; echo; return 0
}

snapshot_all() {  # schreibt <dir>/<name>.bin fuer jede TR-004-Platte
  local dir="$1" d; mkdir -p "$dir"
  for d in $(tr004_devices); do
    rd "$d" 0 "$SNAP_SECTORS" > "$dir/$(basename "$d").bin" || return 1
    [ "$(stat -c%s "$dir/$(basename "$d").bin" 2>/dev/null || stat -f%z "$dir/$(basename "$d").bin")" -eq $((SNAP_SECTORS*512)) ] || return 1
  done
}

# Vergleicht den aktuellen Stand mit dem Abbild und schreibt abweichende Sektoren zurueck.
verify_restore() {
  local dir="$1" d f bad=0 i now; now=$(mktemp -d)
  for d in $(tr004_devices); do
    f="$dir/$(basename "$d").bin"; [ -f "$f" ] || continue
    rd "$d" 0 "$SNAP_SECTORS" > "$now/cur.bin"
    cmp -s "$f" "$now/cur.bin" && continue
    for ((i=0;i<SNAP_SECTORS;i++)); do
      dd if="$f" bs=512 skip=$i count=1 2>/dev/null > "$now/a"
      dd if="$now/cur.bin" bs=512 skip=$i count=1 2>/dev/null > "$now/b"
      cmp -s "$now/a" "$now/b" && continue
      warn "$(t "$d Sektor $i wurde veraendert - wird wiederhergestellt" "$d sector $i was changed - restoring")"
      wr "$d" "$i" "$now/a"
      rd "$d" "$i" 1 > "$now/b"
      if cmp -s "$now/a" "$now/b"; then info "  $(t "$d Sektor $i wiederhergestellt" "$d sector $i restored")"
      else warn "$(t "$d Sektor $i konnte NICHT wiederhergestellt werden! Abbild: $f" "$d sector $i could NOT be restored! Backup: $f")"; bad=1; fi
    done
  done
  rm -rf "$now"; return $bad
}

# ---------- geschuetzter Lauf: Sperre, Abbild, nach jedem Befehl pruefen ----------
MB=""
begin_protected() {
  [ -f "$ENABLED_FLAG" ] || die "$(t "Echtes Auslesen ist noch nicht freigeschaltet. Erst 'tr004-smart check', dann 'tr004-smart enable'." "Reading is not enabled yet. Run 'tr004-smart check', then 'tr004-smart enable'.")"
  command -v "$SMARTCTL" >/dev/null || die "$(t "smartctl nicht gefunden" "smartctl not found")"
  command -v jq >/dev/null || die "$(t "jq nicht gefunden" "jq not found")"
  mkdir -p "$STATE_DIR"
  exec 9>"$LOCK"; flock -w 120 9 || die "$(t "anderer Lauf aktiv" "another run is active")"
  local d; MB=""
  for d in $(tr004_devices); do mailbox_ok "$d" >/dev/null && { MB="$d"; break; }; done
  [ -n "$MB" ] || die "$(t "keine Platte mit sicherem Briefkasten-Sektor - siehe 'tr004-smart list'" "no disk with a safe mailbox sector - see 'tr004-smart list'")"
  SNAP="$STATE_DIR/snap-$(date +%Y%m%d-%H%M%S)-$$"
  snapshot_all "$SNAP" || die "$(t "Abbild konnte nicht erstellt werden" "could not create the backup")"
  MAGIC_BEFORE=$(part_magic)
  trap 'verify_restore "$SNAP"' EXIT INT TERM
}
end_protected() {
  trap - EXIT INT TERM
  verify_restore "$SNAP" || die "$(t "Wiederherstellung fehlgeschlagen - Abbild liegt in $SNAP" "restore failed - backup is in $SNAP")"
  [ "$(part_magic)" = "$MAGIC_BEFORE" ] || \
    die "$(t "Kennung am Partitionsanfang hat sich veraendert! Vorher: $MAGIC_BEFORE / Nachher: $(part_magic) - Array pruefen, tr004-smart nicht mehr benutzen" "signature at the start of a partition changed! Before: $MAGIC_BEFORE / after: $(part_magic) - check the array, stop using tr004-smart")"
  ls -1dt "$STATE_DIR"/snap-* 2>/dev/null | tail -n +21 | xargs -r rm -rf
}
# ein smartctl-Befehl an Einschub <port>; Ausgabe auf stdout, Rueckgabewert von smartctl
jm() {
  local port="$1"; shift
  "$SMARTCTL" -d "$DEVTYPE,$port,s$MAILBOX_LBA" "$@" "$MB" 2>/dev/null; local rc=$?
  verify_restore "$SNAP" || die "$(t "Wiederherstellung fehlgeschlagen - Abbild liegt in $SNAP" "restore failed - backup is in $SNAP")"
  return $rc
}
# smartctl-Text so umschreiben, als waere die Platte direkt angeschlossen
clean_text() { sed -e '/^Device type:/d'; }

# Kennzahlen aus smartctl-Text (Ausgabe als JSON-Objekt)
summarize() {  # summarize <port> <volltext-datei> <attribut-datei>
  local port="$1" full="$2" attr="$3"
  [ -f "$full" ] || full=/dev/null
  [ -f "$attr" ] || attr=/dev/null
  awk -v port="$port" '
    /^(Device Model|Model Number):/ { sub(/^[^:]*:[ \t]*/,""); model=$0 }
    /^Serial Number:/               { sub(/^[^:]*:[ \t]*/,""); serial=$0 }
    /overall-health self-assessment test result:/ { passed = ($NF=="PASSED") ? "true" : ($NF ~ /^FAIL/ ? "false" : "") }
    /^ *[0-9]+ [A-Za-z_]/ && NF>=10 {
      id=$1; raw=$10
      if (id==194) t=raw; if (id==190) t190=raw
      if (id==9) poh=raw; if (id==5) r5=raw; if (id==197) r197=raw; if (id==198) r198=raw
    }
    END {
      if (t=="") t=t190
      q="\""; gsub(/"/,"",model); gsub(/"/,"",serial)
      printf "{\"port\":%d,\"model\":%s,\"serial\":%s,\"passed\":%s,\"temp\":%s,\"power_on_hours\":%s,\"realloc\":%s,\"pending\":%s,\"offline_unc\":%s}\n", port,
        (model==""?"null":q model q), (serial==""?"null":q serial q), (passed==""?"null":passed),
        (t==""?"null":t+0), (poh==""?"null":poh+0), (r5==""?"null":r5+0), (r197==""?"null":r197+0), (r198==""?"null":r198+0)
    }' "$full" "$attr" 2>/dev/null
}

usage() {
if [ "$TR004_LANG" = de ]; then cat <<USAGE
tr004-smart $VERSION - SMART fuer QNAP TR-004 sicher auslesen

  tr004-smart list              TR-004-Platten und Briefkasten-Pruefung anzeigen (nur lesen)
  tr004-smart check             wie list, Rueckgabe 0 nur wenn alles sicher ist
  tr004-smart read [--json]     Werte lesen: jedes Mal Gesundheit/Attribute, stuendlich alles (-x)
  tr004-smart read --full       sofort alles lesen
  tr004-smart exec <port> ARGS  smartctl-Befehl an Einschub <port> (z. B. -t short)
  tr004-smart restore <dir>     Sektoren 0..$((SNAP_SECTORS-1)) aus einem Abbild-Ordner zurueckschreiben
  tr004-smart enable|disable    echtes Auslesen frei- bzw. abschalten

Ablage: $STATE_DIR/port<N>.full (smartctl -x), port<N>.attr (smartctl -H -A), last.json
Einstellungen: $CONF  (MAILBOX_LBA=$MAILBOX_LBA, PORTS="$PORTS")
USAGE
else cat <<USAGE
tr004-smart $VERSION - safely read SMART data from disks in a QNAP TR-004

  tr004-smart list              show TR-004 disks and the mailbox safety check (read only)
  tr004-smart check             like list, exit code 0 only if everything is safe
  tr004-smart read [--json]     read values: health/attributes every run, everything (-x) hourly
  tr004-smart read --full       read everything now
  tr004-smart exec <bay> ARGS   smartctl command for bay <bay> (e.g. -t short)
  tr004-smart restore <dir>     write sectors 0..$((SNAP_SECTORS-1)) back from a backup folder
  tr004-smart enable|disable    enable or disable reading

Files: $STATE_DIR/port<N>.full (smartctl -x), port<N>.attr (smartctl -H -A), last.json
Settings: $CONF  (MAILBOX_LBA=$MAILBOX_LBA, PORTS="$PORTS")
USAGE
fi
}

cmd_list() {
  local d ok=0 msg devs; devs=$(tr004_devices)
  [ -z "$devs" ] && { t "Kein QNAP TR-004 gefunden ($DEV_GLOB)" "No QNAP TR-004 found ($DEV_GLOB)"; echo; return 1; }
  for d in $devs; do
    msg=$(mailbox_ok "$d"); local rc=$?
    printf "%-10s %-6s %s\n" "$d" "$([ $rc -eq 0 ] && echo OK || t NEIN NO)" "$msg"
    [ $rc -eq 0 ] && ok=1
  done
  [ $ok -eq 1 ]
}

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

cmd_read() {
  local json=0 force_full=0 a
  for a in "$@"; do case "$a" in --json) json=1 ;; --full) force_full=1 ;;
    --cron) [ -f "$ENABLED_FLAG" ] || return 0 ;;   # vom Zeitplan: still beenden, solange nicht freigeschaltet
  esac; done
  begin_protected

  # Voll-Lauf (smartctl -x, alle Einschuebe) einmal pro Stunde oder auf Anforderung,
  # sonst nur Gesundheit + Attribute der belegten Einschuebe (1 Befehl pro Platte)
  local act="$STATE_DIR/active_ports" full=1 ports="$PORTS" p rc
  if [ $force_full = 0 ] && [ ! -e "$STATE_DIR/refresh_full" ] && [ -s "$act" ] && \
     [ $(( $(date +%s) - $(mtime "$act") )) -lt "${TR004_FULL_EVERY:-3600}" ] && [ "${TR004_FULL:-0}" != 1 ]; then
    full=0; ports=$(cat "$act")
  fi
  rm -f "$STATE_DIR/refresh_full"
  local found="" tmp; tmp=$(mktemp)
  for p in $ports; do
    if [ $full = 1 ]; then
      jm "$p" -x > "$tmp"; rc=$?
      if grep -q -E "overall-health self-assessment test result: (PASSED|FAIL)" "$tmp"; then
        clean_text < "$tmp" > "$STATE_DIR/port$p.full"; echo $rc > "$STATE_DIR/port$p.full.rc"
        found="$found $p"
      else
        rm -f "$STATE_DIR/port$p".*; continue
      fi
    fi
    jm "$p" -H -A > "$tmp"; rc=$?
    if grep -q -E "overall-health self-assessment test result: (PASSED|FAIL)" "$tmp"; then
      clean_text < "$tmp" > "$STATE_DIR/port$p.attr"; echo $rc > "$STATE_DIR/port$p.attr.rc"
      [ $full = 1 ] || found="$found $p"
    fi
  done
  rm -f "$tmp"
  if [ $full = 1 ]; then echo $found > "$act"
  elif [ "$(echo $found)" != "$(echo $ports)" ]; then rm -f "$act"; fi   # Aenderung -> naechstes Mal komplett
  end_protected

  local out="$STATE_DIR/last.json"
  for p in $(cat "$act" 2>/dev/null); do
    summarize "$p" "$STATE_DIR/port$p.full" "$STATE_DIR/port$p.attr"
  done | jq -s -c '.' > "$out.tmp" && mv "$out.tmp" "$out"

  if [ $json = 1 ]; then cat "$out"
  else jq -r '.[] | "Port \(.port): \(.model // "?") \(.serial // "") | \(if .passed then "OK" elif .passed == false then "FAILED" else "?" end) | \(.temp // "?") C | \(.power_on_hours // "?") h | realloc \(.realloc // 0) pending \(.pending // 0)"' "$out"
  fi
}

# Befehl durchreichen (Selbsttest starten/abbrechen, SMART ein/aus ...), danach Voll-Lauf anstossen
cmd_exec() {
  local port="${1:-}"; shift
  [[ "$port" =~ ^[0-9]+$ ]] || die "$(t "Einschub-Nummer fehlt" "bay number missing")"
  begin_protected
  local tmp rc; tmp=$(mktemp)
  jm "$port" "$@" > "$tmp"; rc=$?
  end_protected
  clean_text < "$tmp"; rm -f "$tmp"
  touch "$STATE_DIR/refresh_full"
  return $rc
}

case "${1:-}" in
  list)    cmd_list ;;
  check)   cmd_list ;;
  read)    shift; cmd_read "$@" ;;
  exec)    shift; cmd_exec "$@" ;;
  restore) [ -d "${2:-}" ] || die "$(t "Abbild-Ordner angeben" "specify a backup folder")"; verify_restore "$2" ;;
  enable)  cmd_list && { mkdir -p "$(dirname "$ENABLED_FLAG")"; touch "$ENABLED_FLAG"; t "freigeschaltet: $ENABLED_FLAG" "enabled: $ENABLED_FLAG"; echo; } ;;
  disable) rm -f "$ENABLED_FLAG"; t "abgeschaltet" "disabled"; echo ;;
  -v|--version) echo "$VERSION" ;;
  *)       usage ;;
esac
